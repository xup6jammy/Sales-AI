@echo off
powershell -NoProfile -ExecutionPolicy Bypass -Command "while ($line = [Console]::ReadLine()) { if ($line -match '\"id\":(\d+)') { $id = $Matches[1] } else { continue }; if ($line -match '\"method\":\"initialize\"') { [Console]::WriteLine('{\"jsonrpc\":\"2.0\",\"id\":' + $id + ',\"result\":{\"protocolVersion\":\"2025-06-18\",\"capabilities\":{},\"serverInfo\":{\"name\":\"fake\",\"version\":\"0.0.1\"}}}') } elseif ($line -match '\"method\":\"tools/list\"') { [Console]::WriteLine('{\"jsonrpc\":\"2.0\",\"id\":' + $id + ',\"result\":{\"tools\":[{\"name\":\"fake.echo\",\"description\":\"echo\",\"inputSchema\":{}}]}}') } elseif ($line -match '\"method\":\"tools/call\"') { [Console]::WriteLine('{\"jsonrpc\":\"2.0\",\"id\":' + $id + ',\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"fake-result\"}]}}') } }"
